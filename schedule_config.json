{
  "tasks": {
    "daily_distill": {
      "trigger": {
        "type": "cron",
        "expression": "0 3 * * *"
      },
      "handler": "claw.scheduler.tasks.daily_memory_distill",
      "enabled": true,
      "description": "凌晨3点蒸馏长期记忆"
    },
    "periodic_memory": {
      "trigger": {
        "type": "interval",
        "seconds": 1800
      },
      "handler": "claw.scheduler.tasks.periodic_memory_update",
      "enabled": true,
      "description": "每30分钟更新所有活跃session的daily memory"
    },
    "idle_compact": {
      "trigger": {
        "type": "event",
        "event_name": "session_activity",
        "idle_timeout_seconds": 600
      },
      "handler": "claw.scheduler.tasks.idle_auto_compact",
      "enabled": true,
      "description": "空闲10分钟自动compact"
    },
    "test_task": {
      "trigger": {
        "type": "interval",
        "seconds": 60
      },
      "handler": null,
      "enabled": false,
      "description": "test",
      "params": {
        "session_id": "sess_b526ba6a0c7049f58adc391b0b38822a",
        "agent_id": "ag_default"
      },
      "peer_key": "web:default:sched:test_task",
      "prompt": "请告诉我几点了"
    }
  }
}
